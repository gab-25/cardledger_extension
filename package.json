{
  "name": "cardledger-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chrome extension that syncs CardLedger with Cardmarket and CardTrader from the user's browser.",
  "cardledger": {
    "productionUrl": "https://cardledger.gabprojects.it"
  },
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "package": "node scripts/package.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "jsdom": "^31.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
